<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:titleTextColor="@color/brand_text" />

    <TextView
        android:id="@+id/excludedHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/brand_excluded_help"
        android:textColor="@color/brand_text_dim"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/excludedSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:hint="@string/brand_excluded_search"
        android:textColor="@color/brand_text"
        android:textColorHint="@color/brand_text_faint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1" />

    <ProgressBar
        android:id="@+id/excludedProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:indeterminateTint="@color/brand_accent" />

    <ListView
        android:id="@+id/excludedList"
        android:divider="@color/brand_glass_stroke"
        android:dividerHeight="1px"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
